func _init() -> void:
	_register(&"pt_BR", PT_BR)
	_register(&"en", EN)


func _register(locale: StringName, table: Dictionary) -> void:
	var translation := Translation.new()
	translation.locale = locale
	for key in table:
		translation.add_message(StringName(key), String(table[key]))
	TranslationServer.add_translation(translation)


static func is_supported(locale: String) -> bool:
	return AVAILABLE_LOCALES.has(locale)
