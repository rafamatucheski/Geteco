extends RefCounted
# Verbatim production dialogue: HarborHospitalInterior3D, HarborPoliceInterior,
# HarborFireStationInterior; terminal text from the corresponding interior.
const PEOPLE := {
	# Moradores de rua dos esgotos de Harbor (`world/places/sewers`).
	"desert_under_culvert_zefa":{"speaker":"Dona Zefa","messages":["Entra, entra, que o sol aqui dentro é de graça. Pouca gente conhece a galeria; quem conhece passa batido.","Meus tapetes seguram o frio da noite. A caixa de latão é minha, mas pode olhar, não tem nada que preste.","O Beto Cascavel mora no fim da galeria. Ele diz que a ponta leste é só entulho. Mentira dele: a duna se mexe."]},
	"desert_under_culvert_beto":{"speaker":"Beto Cascavel","messages":["Devagar aí. Se escutar chocalho, não é o vento.","Cada gaiola é uma cascavel. Vendo o veneno pra gente de fora, ninguém pergunta pra quê.","Dizem que contrabandistas de sal esconderam dinheiro num tubo atrás da duna, na ponta leste. Eu nunca fui. Meu rifle ficou lá faz anos."]},
	"desert_under_well_jaco":{"speaker":"Ermitão Jacó","messages":["Quem desce pelo poço de Santa Lua desce para ouvir o silêncio. Não fale alto.","Cada vela é um pedido. Cada boneco de barro, uma promessa que alguém não cumpriu.","Os fundadores guardaram o que tinham atrás da pedra da lua, no leste. Ela gira, se você souber onde empurrar."]},
	"desert_under_cellar_tiao":{"speaker":"Seu Tião","messages":["Cachaça de cacto, melhor do deserto. Só não conta pro dono do motel que eu falei.","O dono acha que o porão é dele. É meu. Ele só empresta a escada.","Tem uma estante no sudeste que gira. Já escondi gente atrás dela e já escondi cofre também."]},
	"desert_under_cellar_sete":{"speaker":"Hóspede Sete","messages":["Shhh. Eu não existo, tá? O quarto sete do motel nunca foi alugado.","O dono me deixa aqui até a poeira baixar. Faz três semanas.","O cofre atrás de mim é dele. Não encosta, ou ele vai saber."]},
	"desert_under_mine_ozias":{"speaker":"Velho Ozias","messages":["Trinta anos nessa galeria. Entrei pra pegar minha lanterna e nunca mais saí.","Os cristais azuis acendem sozinhos quando alguém chega. Dizem que é a mina avisando.","A veia de ouro ficou do outro lado do desabamento, a leste. Passa uma pessoa só pela fresta. Eu estou gordo demais pra isso."]},
	"sewer_market_abel":{"speaker":"Seu Abel","messages":["Ei, filho. Aqui embaixo o barril esquenta e ninguém pede documento.","Moro neste canto desde que fecharam a oficina do cais. O que eu tinha de valor ficou debaixo do colchão.","Se for pegar, pega só um pouco. É tudo o que me sobrou."]},
	"sewer_quay_marlene":{"speaker":"Dona Marlene","messages":["Sshh, não assusta o peixe. A maré sobe e eles entram pela comporta.","Passa pela passarela com cuidado, as tábuas estão podres de novo.","Do outro lado deixaram uma mochila atrás dos barris. Eu não mexo. Quem mexe aqui embaixo não volta o mesmo."]},
	"sewer_warehouse_zeca":{"speaker":"Zeca","messages":["Trabalhei vinte anos nesses galpões. Hoje durmo debaixo deles. A vida é engraçada.","O escritório de manutenção ainda tem armário trancado, mas a chave sumiu e a porta não.","Já viu o canto sudeste? Os caras do armazém penduravam canos ali pra esconder uma passagem. Eu nunca disse nada."]},
	"sewer_pipe_maluco":{"speaker":"O Maluco","messages":["Shhh. Você ouve? É o cano falando. Ele fala de noite.","Meu machado ficou cravado no entulho. Se o cano ficar bravo, você usa.","Tem dinheiro no caixote. Não é meu. Nada aqui é meu."]},
	"sewer_cistern_nicanor":{"speaker":"Padre Nicanor","messages":["Bem-vindo à minha paróquia, filho. O teto é baixo, mas a fé aqui embaixo é grande.","Dizem que a passarela do lago leva a uma ilha. Eu nunca atravessei: a água escura me conhece pelo nome.","E no canto sudeste há uma parede com uma lona. Que Deus perdoe quem esconde coisas atrás de lonas."]},
	"sewer_cistern_tita":{"speaker":"Tita","messages":["Fogueira é meu lar. Se você tem frio, chega mais perto.","Já vi homem entrar atrás daquela lona e voltar com a mão cheia. Outros não voltaram.","O lago brilha à noite. Não beba e não nade."]},
	"sewer_port_tonho":{"speaker":"Tonho","messages":["Tá vendo a lona no canto nordeste? Aquilo não é só lona.","Os contrabandistas deixam o cofre aberto e a guarda pra quem tiver coragem de passar pelos canos.","Eu fico por aqui, quente, longe da polícia. Eles me deixam em paz se eu não olhar muito."]},
	"sewer_port_nena":{"speaker":"Dona Nena","messages":["Aqui é a minha cozinha. Pega um café, vai.","As caixas do sul são deles. Armas, tudo envolvido em pano. Eu só varro a calçada do canal.","Se pegar o dinheiro do cofre grande, leva as granadas também. Já vi homem morrer por esquecer uma."]},
	"hospital_miguel":{"speaker":"Dr. Miguel","messages":["Pode pegar a vida junto aos leitos. Vou cuidar de você.","Procure atendimento sempre que precisar."]},
	"hospital":{"speaker":"Enfermeira Clara","messages":["Pode pegar a vida junto aos leitos. Vou cuidar de você.","Procure atendimento sempre que precisar."]},
	"police":{"speaker":"Sargento Morales","messages":["Harbor Patrol, 1º Distrito. Mantenha as mãos onde eu possa vê-las, cidadão.","O cais de Breakwater tá tenso ultimamente. Carga sumindo dos contêineres e os Cobras de Ferro rondando.","Se você vir algo suspeito nos becos da Foundry Avenue, venha direto ao balcão.","Não toleramos rachas nem tiroteios no perímetro do porto. Considere isso um aviso amigável."]},
	"ribeiro":{"speaker":"Detetive Ribeiro","messages":["Estamos mapeando a rede de receptação dos Cobras de Ferro no Píer Leste.","Motores adulterados, nitro contrabandeado... eles estão montando uma frota para disputas pesadas.","Aquele mural na parede não mente: cada foto tem ligação direta com os galpões do porto."]},
	"ferreira":{"speaker":"Policial Ferreira","messages":["Custódia temporária. Mantenha distância das grades, cidadão.","O suspeito ali dentro foi apanhado tentando desviar peças nos trilhos da ferrovia.","Delegacia não é ponto turístico. Faça o que veio fazer e siga seu caminho."]},
	"prisoner":{"speaker":"Dente de Ouro","messages":["Tá encarando o quê? Sai da frente da grade, moleque.","Eles acham que essas barras de ferro vão segurar os Cobras... logo, logo meu advogado chega.","Se você veio procurar o Vicente... aquele sumiu no mapa faz tempo, tá correndo em outro nível."]},
	"cida":{"speaker":"Dona Cida","messages":["Vim prestar queixa sobre umas corridas barulhentas no cais de madrugada.","Estou esperando há quase uma hora... esses policiais só correm atrás de caso grande.","Tome cuidado pelas ruas à noite, meu jovem. O porto não perdoa distrações."]},
	"fire_station":{"speaker":"Capitão Rocha","messages":["Quartel 03 em alerta constante. O porto tem risco químico e contêineres inflamáveis 24 horas por dia.","Nossas três viaturas precisam de saída livre nas baias. Nunca obstrua o pátio externo de manobra.","Se soar o alarme, todo mundo se afasta dos portões e abre caminho pro caminhão.","Temos trajes de combate a incêndio nos armários à esquerda se você quiser verificar o equipamento."]},
	"police_terminal":{"speaker":"Terminal","messages":["OCORRÊNCIA #304: Suspeita de desvio de contêiner com motores preparados no Píer Leste.\nALERTA GERAL: Facção Cobras de Ferro monitorada nas imediações da Foundry Avenue.\nSTATUS DO DISTRITO: Patrulha tática em prontidão • 1 detento sob custódia temporária."]},
	"hospital_triage":{"speaker":"Triagem","messages":["TRIAGEM MÉDICA (BAY MEDICAL):\n• Sinais vitais avaliados: Pressão arterial 120/80 mmHg, Pulso 72 BPM regular.\n• Quadro clínico geral estável.\n• Para atendimento ambulatorial ou curativos, consulte a Enfermeira Clara."]},
	"fire_alarm":{"speaker":"Alarme","messages":["TESTE DE SIRENE E PRONTIDÃO DE RESGATE:\n• Sirene de teste acionada e sinalizadores operacionais.\n• Pressão da rede de hidrantes: 15 bar (Nominal).\n• Equipamentos de combate a incêndio e macas inspecionados."]}
}
static func lines(id: String) -> Array:
	var result: Array = []
	var source: Dictionary = PEOPLE.get(id,{})
	for message in source.get("messages",[]): result.append({"speaker":source.speaker,"message":message})
	return result
