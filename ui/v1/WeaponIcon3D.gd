extends Control

var weapon_id: String = "fists"
static var icon_textures: Dictionary = {}
static var _texture_users := 0
var _silhouette_material: ShaderMaterial
@export var frameless := false

const FRAMELESS_SHADER = preload("res://ui/v1/WeaponSilhouette.gdshader")
const ICON_DATA := {
	"ak47": {"ext": "png", "data": ""},
	"axe": {"ext": "svg", "data": ""},
	"bat": {"ext": "svg", "data": ""},
	"fists": {"ext": "svg", "data": ""},
	"flamethrower": {"ext": "png", "data": ""},
	"grenade": {"ext": "png", "data": ""},
	"hunting_rifle": {"ext": "svg", "data": ""},
	"knife": {"ext": "svg", "data": ""},
	"knuckles": {"ext": "svg", "data": ""},
	"m4a1": {"ext": "png", "data": ""},
	"magnum": {"ext": "png", "data": ""},
	"pistol": {"ext": "png", "data": ""},
	"rpg": {"ext": "png", "data": ""},
	"sawed_off": {"ext": "png", "data": ""},
	"shotgun": {"ext": "png", "data": ""},
	"smg": {"ext": "png", "data": ""}
}

func _ready() -> void:
	_texture_users += 1
	_load_textures()
	if frameless:
		var silhouette := ShaderMaterial.new()
		silhouette.shader = FRAMELESS_SHADER
		silhouette.set_shader_parameter("silhouette_color",preload("res://ui/GameStyle.gd").TEXT)
		_silhouette_material = silhouette
		material = null if weapon_id == "fists" else _silhouette_material
	resized.connect(queue_redraw)

func _exit_tree() -> void:
	_texture_users = maxi(0,_texture_users-1)
	if _texture_users==0: icon_textures.clear()

func _load_textures() -> void:
	if not icon_textures.is_empty(): return
	for id in ICON_DATA:
		var source: Dictionary = ICON_DATA[id]
		var bytes := Marshalls.base64_to_raw(str(source.data))
		var image := Image.new()
		var error := image.load_svg_from_buffer(bytes) if source.ext == "svg" else image.load_png_from_buffer(bytes)
		if error == OK: icon_textures[id] = ImageTexture.create_from_image(image)

func set_weapon(id: String) -> void:
	weapon_id = id
	if frameless: material = null if id == "fists" else _silhouette_material
	if icon_textures.is_empty(): _load_textures()
	queue_redraw()

func _draw() -> void:
	var texture: Texture2D = icon_textures.get(weapon_id, null)
	if texture == null: return
	var texture_size := texture.get_size()
	var fit := minf(size.x / texture_size.x, size.y / texture_size.y)
	var fitted_size := texture_size * fit
	draw_texture_rect(texture, Rect2((size - fitted_size) * 0.5, fitted_size), false)
