; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Geteco"
run/main_scene="res://ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
config/icon="uid://dky3iflkm2253"

[autoload]

ProjectTypography="*res://ui/ProjectTypography.gd"
PresentationBudget="*res://systems/PresentationBudget.gd"
Localization="*res://systems/Localization.gd"
SettingsManager="*res://systems/SettingsManager.gd"
MissionVoiceMixer="*res://audio/MissionVoiceMixer.gd"
WantedManager="*res://police/WantedManager.gd"
EmergencyPool="*res://emergency/EmergencyPool.gd"
CityAudioManager="*res://CityAudioManager.gd"
TrafficLightManager="*res://geodata/TrafficLightManager.gd"
CampaignState="*res://systems/CampaignState.gd"
NPCMedicalCare="*res://emergency/NPCMedicalCare.gd"
WorldRenewal="*res://systems/WorldRenewal.gd"
DistrictRestriction="*res://systems/DistrictRestrictionManager.gd"
SaveManager="*res://systems/SaveManager.gd"
RegionTravel="*res://systems/RegionTravel.gd"
GameInput="*res://ui/GameInput.gd"
GameLoading="*res://ui/GameLoading.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/missing_tool=0
gdscript/warnings/redundant_await=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/int_as_enum_without_cast=0
gdscript/warnings/confusable_identifier=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/confusable_local_usage=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/city_layout_editor/plugin.cfg")

[gui]

theme/custom="res://ui/ProjectTheme.tres"
theme/custom_font="res://assets/fonts/barlow/BarlowSemiCondensed-Regular.ttf"

