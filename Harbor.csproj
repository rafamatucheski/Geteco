<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Official Android templates embed .NET 9; desktop remains on .NET 10. -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Harbor</RootNamespace>
    <AssemblyName>Harbor</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Cópias de diagnóstico e builds não são código do jogo. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);evidence/**;builds/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
