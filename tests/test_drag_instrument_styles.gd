extends SceneTree
const STYLES := preload("res://activities/desert_drag/DragInstrumentStyles.gd")
const PROGRESS := preload("res://activities/desert_drag/DesertDragProgress.gd")
const ECONOMY := preload("res://systems/economy/Economy.gd")
const RECEIPTS := preload("res://systems/economy/RecurringReceipts.gd")
const CONTRACT := preload("res://runtime/desert/DesertSaveContract.gd")
const DIGO := preload("res://systems/campaign/DigoProgress.gd")
const GAME_STATE := preload("res://runtime/GameState.gd")
const SAVE_STORE := preload("res://runtime/SaveStore.gd")
const FIXTURE := preload("res://tests/fixtures/NorthGatewayFixtures.gd")
var checks := 0
var failures: Array[String]=[]

func check(ok: bool,label: String) -> void:
	checks+=1
	print("DRAG_INSTRUMENTS ","PASS " if ok else "FAIL ",label)
	if not ok: failures.append(label)

func _initialize() -> void:
	var world: Dictionary={}
	var economy := ECONOMY.new()
	check(STYLES.validate_wallet(world,economy.snapshot()) and CONTRACT.valid(world,economy.snapshot()),"old saves without instruments remain valid")
	check(STYLES.selection(world)=="classic" and STYLES.owned(world,"classic") and STYLES.owned(world,"bar"),"both base layouts are free and circular is default")
	check(world.is_empty(),"default lookup never mutates old saves")
	var rows := STYLES.definitions()
	rows[2].price=1
	check(STYLES.CATALOG.street.price==1500,"UI receives detached catalog rows")
	var action := STYLES.select(world,economy,"bar")
	check(action.ok and action.changed and action.cost==0 and STYLES.selection(world)=="bar","free bar layout equips without funds")
	check(economy.snapshot().transactions.is_empty(),"free layout writes no payment receipt")
	var before_world := world.duplicate(true)
	var before_wallet := economy.snapshot()
	check(STYLES.select(world,economy,"street").reason=="locked","premium instrument requires earned distinct victory")
	check(world==before_world and economy.snapshot()==before_wallet,"locked purchase mutates neither wallet nor ownership")
	check(STYLES.select(world,economy,"fake").reason=="unknown_style","unknown cosmetic cannot be purchased")
	PROGRESS.record_finish(world,"digo",true,21)
	DIGO.complete_desert_race(world,DIGO.DESERT_RACE_ID,true)
	before_world=world.duplicate(true)
	check(STYLES.select(world,economy,"street").reason=="insufficient_funds","unlocked purchase requires actual wallet balance")
	check(world==before_world and economy.snapshot()==before_wallet,"failed payment cannot equip or claim ownership")
	economy.grant_reward("instrument_test_cash",1500)
	var championship := PROGRESS.data(world)
	action=STYLES.purchase_and_equip(world,economy,"street")
	check(action.ok and action.purchased and action.cost==1500 and economy.balance==0,"purchase charges exact real-wallet price and equips")
	check(STYLES.owned(world,"street") and STYLES.selection(world)=="street","purchased instrument is owned and selected")
	check(RECEIPTS.lookup(economy.snapshot(),"spend","drag_instrument:street").get("amount")==1500,"durable receipt proves payment")
	before_wallet=economy.snapshot()
	action=STYLES.select(world,economy,"street")
	check(action.ok and not action.changed and not action.purchased and economy.snapshot()==before_wallet,"repeated click does not charge or create another transaction")
	check(STYLES.equip(world,economy,"bar").ok and STYLES.equip(world,economy,"street").ok and economy.balance==0,"owned layouts can be changed freely at zero balance")
	check(PROGRESS.data(world)==championship,"cosmetics do not alter race records unlocks or prizes")
	check(STYLES.equip(world,economy,"pro").reason=="not_owned","equip-only API cannot purchase a locked or unowned layout")
	PROGRESS.record_finish(world,"digo",true,20)
	PROGRESS.record_finish(world,"digo",true,19)
	check(not STYLES.unlocked(world,"pro"),"repeated wins against one rival do not unlock three-win layout")
	for identity in ["livia","raul"]: PROGRESS.record_finish(world,identity,true,20)
	check(STYLES.unlocked(world,"pro") and not STYLES.unlocked(world,"champion"),"third distinct victory unlocks Pro only")
	economy.grant_reward("instrument_test_more_cash",10000)
	check(STYLES.select(world,economy,"pro").ok and economy.balance==6500,"Pro costs R$3500")
	for identity in ["jessica","nadir"]: PROGRESS.record_finish(world,identity,true,20)
	check(STYLES.unlocked(world,"champion"),"five distinct wins unlock champion")
	check(STYLES.select(world,economy,"champion").ok and economy.balance==0,"Champion costs R$6500")
	check(PROGRESS.pending_rewards(world,economy.snapshot()).size()==5,"instrument purchases leave all race reward claims untouched")
	check(CONTRACT.valid(world,economy.snapshot()),"instrument payment provenance joins production save contract")
	var packed: Dictionary=JSON.parse_string(JSON.stringify({"world":world,"wallet":economy.snapshot()}))
	var restored_economy := ECONOMY.new()
	check(restored_economy.restore_snapshot(packed.wallet) and CONTRACT.valid(packed.world,restored_economy.snapshot()),"ownership selection and wallet survive real validator after JSON roundtrip")
	check(STYLES.selection(packed.world)=="champion" and STYLES.owned(packed.world,"street"),"restored selected layout and earlier purchases are retained")
	check_file_persistence(world,economy)
	var bad_world := world.duplicate(true)
	bad_world[STYLES.KEY].owned.erase("street")
	check(not STYLES.validate_wallet(bad_world,economy.snapshot()),"receipt without cosmetic ownership is rejected")
	var bad_wallet := economy.snapshot()
	bad_wallet.transactions.erase("spend:drag_instrument:street")
	check(not STYLES.validate_wallet(world,bad_wallet),"cosmetic ownership without payment is rejected")
	bad_wallet=economy.snapshot()
	bad_wallet.transactions["spend:drag_instrument:street"].amount=1
	check(not STYLES.validate_wallet(world,bad_wallet),"altered paid amount is rejected")
	bad_wallet=economy.snapshot()
	bad_wallet.transactions["spend:drag_instrument:fake"]={"kind":"spend","item":"drag_instrument:fake","amount":1}
	check(not STYLES.validate_wallet(world,bad_wallet),"unknown instrument receipt is rejected")
	bad_world=world.duplicate(true)
	bad_world[STYLES.KEY].selected="fake"
	check(not CONTRACT.valid(bad_world,economy.snapshot()),"production save validation rejects invalid selected instrument")
	bad_world=world.duplicate(true)
	bad_world[STYLES.KEY].owned.append("bar")
	check(not STYLES.validate_snapshot(bad_world[STYLES.KEY]),"duplicate ownership is rejected")
	bad_world={STYLES.KEY:{"version":1,"owned":["classic","bar","street"],"selected":"street"}}
	bad_wallet=ECONOMY.new().snapshot()
	bad_wallet.transactions["spend:drag_instrument:street"]={"kind":"spend","item":"drag_instrument:street","amount":1500}
	check(not STYLES.validate_wallet(bad_world,bad_wallet),"payment cannot manufacture required campaign victories")
	var capacity_wallet := ECONOMY.new()
	var capacity_data := capacity_wallet.snapshot()
	capacity_data.balance=2000
	for i in ECONOMY.MAX_OPAQUE_RECEIPTS:
		var receipt_id := "capacity_fixture_"+str(i)
		capacity_data.transactions["spend:"+receipt_id]={"kind":"spend","item":receipt_id,"amount":0}
	check(capacity_wallet.restore_snapshot(capacity_data),"full receipt ledger is a valid isolated wallet fixture")
	var capacity_world: Dictionary={}
	PROGRESS.record_finish(capacity_world,"digo",true,21)
	before_wallet=capacity_wallet.snapshot()
	before_world=capacity_world.duplicate(true)
	check(STYLES.select(capacity_world,capacity_wallet,"street").reason=="transaction_refused","wallet capacity failure rejects purchase even with funds")
	check(capacity_wallet.snapshot()==before_wallet and capacity_world==before_world,"refused receipt is atomic: no debit or ownership")
	print("DRAG_INSTRUMENT_STYLES checks=%d failures=%d"%[checks,failures.size()])
	quit(0 if failures.is_empty() else 1)

func check_file_persistence(world: Dictionary,economy) -> void:
	var game := GAME_STATE.new()
	check(game.restore_snapshot(FIXTURE.full_snapshot(Vector3.ZERO,true)),"production GameState accepts isolated campaign fixture")
	game.world_state.merge(world,true)
	check(game.economy.restore_snapshot(economy.snapshot()),"production GameState uses the paid shared wallet")
	var folder := FIXTURE.output_dir("drag-instrument-persistence")
	if folder.is_empty():
		check(false,"isolated persistence directory created")
		return
	var store := SAVE_STORE.new()
	store.path=folder.path_join("progress.json")
	check(store.save(game)==OK,"real SaveStore writes purchased instruments and wallet together")
	var loaded := GAME_STATE.new()
	var response := store.load_into(loaded)
	check(response.get("ok",false),"real SaveStore loads the isolated instrument save")
	if not response.get("ok",false): return
	check(STYLES.selection(loaded.world_state)=="champion" and loaded.economy.balance==0,"disk roundtrip retains selected premium panel and exact balance")
	check(STYLES.validate_wallet(loaded.world_state,loaded.economy.snapshot()),"disk-loaded ownership has exact shared-wallet receipts")
	check(STYLES.equip(loaded.world_state,loaded.economy,"street").ok and loaded.economy.balance==0,"previously purchased panel equips after reload without payment")
	check(store.save(loaded)==OK,"changed selection saves through normal backup rotation")
	var reloaded := GAME_STATE.new()
	check(store.load_into(reloaded).get("ok",false) and STYLES.selection(reloaded.world_state)=="street","equipped choice persists across a second disk load")
	var before := reloaded.snapshot()
	var forged := before.duplicate(true)
	forged.economy.transactions.erase("spend:drag_instrument:street")
	check(not reloaded.restore_snapshot(forged) and reloaded.snapshot()==before,"GameState rejects missing receipt before mutating live state")
	print("DRAG_INSTRUMENT_SAVE ",ProjectSettings.globalize_path(store.path))
