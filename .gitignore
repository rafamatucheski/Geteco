# Godot 4 import cache - regenerated automatically, must never be versioned
.godot/

# Godot editor / OS junk
.import/
export.cfg
export_presets.cfg
*.translation
.DS_Store
Thumbs.db

# Cache de bytecode do Python, gerado ao rodar scripts em tools/
__pycache__/

# Logs and local test scratch
*.log

# Erros de execucao de teste (mesma natureza de *.log, que ja e ignorado)
*.err

# WAVs soltos das camadas de motor: saida de tests/measure_engine_families.gd,
# regeneravel em segundos e pesada (30 arquivos de ~44 KB). O relatorio de texto
# ao lado deles fica versionado.
docs/measurements/engine_layers/

# Cache de shader (Vulkan) dentro de app_userdata/ capturado por auditorias de
# performance que rodam com --appdata isolado (tests/perf_audit_*/results/).
# E lixo de engine regeneravel, igual ao .godot/ acima -- e em Windows os
# nomes de arquivo do cache (hash + .vulkan.cache) somados ao caminho aninhado
# passam do limite de 260 caracteres do git, quebrando o commit.
shader_cache/
