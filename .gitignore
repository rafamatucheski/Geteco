.godot/
*.log
*.tmp

# Evidências de validação: relatórios relevantes (.md, .json, .patch) são
# selecionados explicitamente com git add -f; execuções e cópias ficam locais.
# Capturas, vídeos e exports ficam no disco: ~1,7 GB em 2026-09-24, e o GitHub
# recusa arquivos acima de 100 MB.
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.jpeg
evidence/**/*.webp
evidence/**/*.gif
evidence/**/*.exr
evidence/**/*.avi
evidence/**/*.mp4
evidence/**/*.webm
evidence/**/*.wav
evidence/**/*.ogg
evidence/export/

# Exports do jogo e caches regeneráveis.
*.pck
*.cache
.secrets/
*.err
__pycache__/

# Relatórios de cada execução da suíte (tests/run_suite.ps1): mudam a cada rodada.
evidence/test-suite/

# Artefatos locais de revisão e distribuição; preservar fora do histórico.
evidence/**/chrome-profile/
evidence/**/baseline-project/
builds/
/artifacts/perf-release/
/addons/terrain_3d/bin/~*.dll
*.apk
*.aab
*.keystore
*.jks
.godot/export_credentials.cfg

# Copias congeladas do projeto usadas em medicoes; nao sao fontes do jogo ativo.
evidence/sol61-fluidity-ab-20261001/before/
evidence/sol61-fluidity-ab-20261001/after/
evidence/sol61-fluidity-ab-20261001/runs/*/project/
evidence/auditoria-viaria/20260929-correcoes/perf-projects/

# Evita incluir milhares de relatórios brutos e snapshots em commits do jogo.
# Relatórios já versionados continuam sendo acompanhados normalmente.
/evidence/

# Experimentos, capturas e copias locais; fontes e assets ativos ficam versionados.
/output/
/tmp/

# Saídas de testes e capturas (res://artifacts): geradas a cada execução, ficam no disco.
/artifacts/
# Logs e sondas soltas de evidência; só relatórios .md/.json/.patch entram no Git.
evidence/**/*.log
evidence/**/*.gd
