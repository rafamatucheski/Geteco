; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Geteco V2"
run/main_scene="res://ui/MainMenu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="GetecoV2"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60

[autoload]

GameInput="*res://runtime/GameInput.gd"
V2Settings="*res://runtime/Settings.gd"
V2Launch="*res://runtime/SessionLaunch.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/Barlow.ttf"

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.52, 0.66, 0.72, 1)
